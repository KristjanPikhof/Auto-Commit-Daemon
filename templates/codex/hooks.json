{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "bash -c 'acd internal integration event --harness codex --event session_open'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "bash -c 'acd internal integration event --harness codex --event activity'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "bash -c 'acd internal integration event --harness codex --event activity'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "bash -c 'acd internal integration event --harness codex --event activity'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'acd internal integration event --harness codex --event activity'"
          }
        ]
      }
    ]
  }
}
